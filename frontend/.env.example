# Use mock services for any feature the backend does not implement yet.
VITE_USE_MOCK=true

# Comma-separated services that call the real API even while VITE_USE_MOCK=true.
# Known values: auth, accounts, categories, transactions, analytics. Leave blank to mock everything.
VITE_LIVE_SERVICES=auth,accounts,categories,transactions,analytics

# The frontend always calls relative paths under this base. Vite proxies them in development.
VITE_API_BASE=/api/v1

# FastAPI origin used by the Vite dev proxy (python -m uvicorn app.main:app --reload).
VITE_PROXY_TARGET=http://localhost:8000
