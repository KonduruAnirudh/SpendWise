# Use mock services for any feature the backend does not implement yet.
VITE_USE_MOCK=true

# Comma-separated services that call the real API even while VITE_USE_MOCK=true.
# Known values: auth, categories. Leave blank to mock everything.
VITE_LIVE_SERVICES=auth,categories

# Frontend always calls relative /api paths. Vite proxies these in development.
VITE_API_BASE=/api

# API origin used by the Vite dev proxy. Change this for staging if needed.
VITE_PROXY_TARGET=http://localhost:8080

# Auth0 SPA application. Leave blank to use demo email/password only.
# In the Auth0 dashboard, Application type must be Single Page Application.
# Allowed Callback URLs: http://localhost:5173
# Allowed Logout URLs:    http://localhost:5173
# Allowed Web Origins:    http://localhost:5173
# Open the app at http://localhost:5173 (not 127.0.0.1).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Optional API audience if the Spring Boot API uses Auth0.
# VITE_AUTH0_AUDIENCE=
